  "key_findings": {
    "finding_1": "Combined fusion achieves best overall accuracy (84.83%) with only 2 trainable parameters",
    "finding_2": "Audio-text modality (68.64% fusion weight) dominates emotion recognition in conversational contexts",
    "finding_3": "Video modality underperforms (53.09%) but still contributes to fusion improvement",
    "finding_4": "Sad and happy emotions achieve highest F1-scores (>88%) due to clear distinctive features",
    "finding_5": "Surprised emotion shows lowest accuracy (52.91%) due to confusion with happy",
    "finding_6": "Class imbalance (25:1 ratio) impacts model performance on rare emotions",
    "finding_7": "Late fusion is 48× faster to train than base models while improving accuracy"
  },
  
